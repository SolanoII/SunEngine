+                                part.roughness, part.metallic, part.emissive);
+                        }
+                    }
+                    else {
+                        deferred.DrawCube(transform.GetTransform(), baseColor, 0.9f, 0.0f, 0.0f);
+                    }
                 }
             }
         }
