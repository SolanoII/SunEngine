+    // ===================== PERSONAGGIO ANIMATO =====================
+    // Stato dei comandi che pilota le animazioni (stessi tasti usati dal movimento).
+    RifleAnimInput GameLayer::BuildPlayerAnimInput(bool isAiming) {
